APP_ENV=dev
SECRET_KEY=please-change-me-to-a-32+char-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/db/app.db
UPLOAD_DIR=./data/uploads

# First-run admin: auto-created on startup when the DB has no such user.
# Packaged builds ship an empty DB, so this gives you a ready admin to log in.
# Change the password after first login (or before distributing).
BOOTSTRAP_ADMIN_EMAIL=chenya402@126.com
BOOTSTRAP_ADMIN_PASSWORD=123456
BOOTSTRAP_ADMIN_NAME=Admin

# 统一认证中心 (OIDC). Disabled by default → local email/password login.
# Enable to delegate login to the auth center (SSO across products). Register the
# product at {ISSUER}/admin to get client_id/secret; REDIRECT_URI must match the
# registered callback EXACTLY and point at this product's /api/auth/oidc/callback.
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.romtekcae.com:5000
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://你的产品域名/api/auth/oidc/callback
OIDC_POST_LOGIN_PATH=/app

# LLM provider — DeepSeek by default, but users can BYOK on the frontend
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Sandbox limits
SANDBOX_CPU_SECONDS=10
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=10485760

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
