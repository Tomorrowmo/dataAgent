APP_ENV=dev
SECRET_KEY=please-change-me-to-a-32+char-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/db/app.db
UPLOAD_DIR=./data/uploads

# LLM provider — DeepSeek by default, but users can BYOK on the frontend
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Sandbox limits
SANDBOX_CPU_SECONDS=10
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=10485760

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
