# 认证中心地址（标准 OIDC Provider）
OIDC_ISSUER=https://auth.romtekcae.com:5000
# 在认证中心 /admin「OAuth 客户端」登记本 demo 后获得（回调填 http://localhost:5005/auth/callback）
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 必须与登记的回调完全一致
OIDC_REDIRECT_URI=http://localhost:5005/auth/callback
# Flask session 签名密钥，随便填个随机串
APP_SECRET_KEY=change-me-to-a-random-string
